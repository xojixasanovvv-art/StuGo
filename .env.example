# ---------------------------------------------------------------------------
# StuGo backend sozlamalari
#
# Nusxalash:  cp .env.example .env
# Production'da quyidagi qiymatlarni ALMASHTIRISH shart.
# ---------------------------------------------------------------------------

# --- Xavfsizlik (MAJBURIY) -------------------------------------------------
# Generatsiya:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Lokal ishlash uchun True. Production'da False BO'LISHI SHART.
DEBUG=True

# Vergul bilan ajratilgan. Masalan: localhost,127.0.0.1
# 0.0.0.0 faqat lokal/server tarmog'iga chiqish kerak bo'lganda qo'shiladi
# (`daphne -b 0.0.0.0`). Production'da faqat haqiqiy domenlarni yozing.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend boshqa port/origin'da ishlayotgan bo'lsa (masalan React 5173):
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- OTP --------------------------------------------------------------------
# FAQAT lokal rivojlash uchun. Production'da True BO'LISHI MUTLAQO SHART EMAS.
# True bo'lsa OTP kodi API javobida qaytariladi.
OTP_DEBUG_RETURN_CODE=True

OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Throttle limitlar (odatda o'zgartirish shart emas)
# Lokal rivojlash uchun osonlik: 500/hour. Production'da ASLI qoldiring
# (5/hour) — aks holda haker OTP kombinatsiyalarini sinab ko'ra oladi.
THROTTLE_OTP_SEND=500/hour
THROTTLE_OTP_VERIFY=500/hour
THROTTLE_MESSAGE_SEND=60/hour
THROTTLE_LISTING_CREATE=20/day

# --- Universitet email domenlari (vergul bilan) ---------------------------
# Talaba "o'z universiteti" ekanini shu domenlar orqali tasdiqlaydi.
# Iltimos, o'zingizning OTM domenlaringizni qo'shing.
UNIVERSITY_EMAIL_DOMAINS=uz,ut.uz,uz.uz,web.uz,natlib.uz,umma.uz,uzm.uz,tuit.uz,ntuit.uz,newuu.uz,ntu.uz,tu.uz,webmail.uz,sdu.uz,andijon.uz,buxoro.uz,namangan.uz,jizzakh.uz,sirdaryo.uz,surxondaryo.uz,kashkadaryo.uz,khorazm.uz,tashkent.uz,qarshi.uz,termez.uz,gdu.uz,uzbekistan.uz

# --- Database --------------------------------------------------------------
# DB_NAME bo'sh bo'lsa SQLite ishlatiladi (lokal).
# PostgreSQL uchun to'ldiring:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=stugo
# DB_USER=stugo
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis (production uchun MAJBURIY) -------------------------------------
# Bo'sh bo'lsa LokalMemCache + InMemoryChannelLayer ishlatiladi —
# ko'p worker holatida WebSocket va OTP ishlmaydi.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Celery (background tasklar: rasm kompressiya, bildirishnoma) -----------
# Hali ishlatilmaydi, lekin sozlamalar tayyor.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Boshqa ----------------------------------------------------------------
LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO

# --- SSL / HTTP xavfsizligi ------------------------------------------------
# DEBUG=False bo'lganda quyidagilar AVTOMATIK yoqiladi
# (SECURE_SSL_REDIRECT, HSTS 1 yil + subdomains + preload).
# Faqat TLS terminatsiyasi nginx/caddy orqasida bo'lganda kerak.
# localhost'da HTTPS yo'q bo'lsa, `LOCAL_HTTP=True` qo'ying —
# aks holda barcha so'rovlar 301 ga ketadi va devtools ishlamaydi.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# LOCAL_HTTP=False
# --- Frontend (templates/index.html) ---------------------------------------
# Frontend Django bilan bir serverda ishlanganda (tanlangan holat) hech narsa
# sozlamasiz — `/api/v1` va `ws://<shu-host>` ishlatiladi.
#
# Alohida frontend serverda (React/Vue, masalan 5173) ishlatish uchun
# `templates/index.html` dagi `<script>` dan OLDIN shu satrlarni qo'shing:
#
#   <script>window.STUGO_API_BASE = 'https://api.stugo.uz/api/v1';</script>
#   <script>window.STUGO_WS_ORIGIN = 'wss://api.stugo.uz';</script>
#
# Eslatma: WebSocket alohida subdomain/origin'da bo'lsa CORS emas,
# `Sec-WebSocket-Protocol` orqali token uzatiladi.

# Telefon operator kodlari (ixtiyoriy).
# O'zbekistondagi barcha rasmiy mobil/region kodlari allaqachon kodda bor
# (20, 33, 50, 55, 61, 62, 65, 66, 67, 69, 70, 71, 72, 73, 74, 75, 76, 77,
#  78, 79, 80, 87, 88, 90, 91, 92, 93, 94, 95, 97, 98, 99).
# Bu qiymat faqat QUSHIMCHA kodlar uchun — yangi operator chiqsa shu yerga
# yozing, kodga tegish shart emas.
# PHONE_OPERATOR_CODES=21,22
